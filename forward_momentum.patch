+func (orchestrator *Orchestrator) drainQueueResults(resolved []*primitive.Value) ([]*primitive.Value, error) {
+	if orchestrator == nil || orchestrator.queue == nil {
+		return resolved, nil
+	}
+
+	frameBytes := core.Cfg.Value.Bytes
+	buf := make([]byte, frameBytes)
+
+	for orchestrator.queue.OutputLen() >= frameBytes {
+		n, readErr := orchestrator.queue.Read(buf)
+		if readErr != nil && !errors.Is(readErr, io.EOF) {
+			return resolved, readErr
+		}
+		if n != frameBytes {
+			break
+		}
+
+		value := primitive.AllocValue()
+		if err := value.LoadFullFrame(buf); err != nil {
+			primitive.FreeValue(value)
+			return resolved, err
+		}
+
+		decision := orchestrator.evaluateResult(value)
+		if decision.Reinject {
+			if err := orchestrator.reinjectValue(value, buf); err != nil {
+				_ = value.Close()
+				return resolved, err
+			}
+		}
+
+		if decision.Resolved {
+			resolved = append(resolved, value)
+			continue
+		}
+
+		_ = value.Close()
+	}
+
+	return resolved, nil
+}
+
+func (orchestrator *Orchestrator) reinjectValue(value *primitive.Value, buf []byte) error {
+	if orchestrator == nil || orchestrator.field == nil || value == nil {
+		return nil
+	}
+
+	if len(buf) < core.Cfg.Value.Bytes {
+		buf = make([]byte, core.Cfg.Value.Bytes)
+	}
+
+	if _, err := value.Read(buf); err != nil && !errors.Is(err, io.EOF) {
+		return err
+	}
+
+	_, err := orchestrator.field.Write(buf)
+	return err
+}
