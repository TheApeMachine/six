+func normalizeClassificationLabelText(raw []byte, labels []string) (int, bool) {
+	normalized := strings.ToLower(strings.TrimSpace(string(raw)))
+	if normalized == "" {
+		return 0, false
+	}
 
+	if idx, err := strconv.Atoi(normalized); err == nil {
+		return normalizeClassificationLabelIndex(idx, labels)
+	}
 
+	for idx, label := range labels {
+		if normalized == strings.ToLower(strings.TrimSpace(label)) {
+			return idx, true
+		}
+	}
+
+	return 0, false
+}
