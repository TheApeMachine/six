+type pipelineSubstrateFinalizer interface {
+	Finalize(any) error
+}
+
+type pipelineFinalizer interface {
+	Finalize() error
+}
+
+func runPipelineFinalizers(experiment tools.PipelineExperiment, substrate any) error {
+	var errs []error
+
+	if finalizer, ok := experiment.(pipelineSubstrateFinalizer); ok {
+		errs = append(errs, finalizer.Finalize(substrate))
+	}
+
+	if finalizer, ok := experiment.(pipelineFinalizer); ok {
+		errs = append(errs, finalizer.Finalize())
+	}
+
+	return errors.Join(errs...)
+}
+
+func selectPipelineReadout(resolved []*primitive.Value) *primitive.Value {
+	for _, value := range resolved {
+		if value == nil {
+			continue
+		}
+
+		if value.EmitRequested() {
+			return value
+		}
+
+		switch value.Role() {
+		case primitive.ValueRoleReadout, primitive.ValueRoleAssociation:
+			return value
+		}
+	}
+
+	for _, value := range resolved {
+		if value != nil {
+			return value
+		}
+	}
+
+	return nil
+}
+
+func readoutGenerationForPipeline(resolved []*primitive.Value, fallback *primitive.Value) []byte {
+	generation := []byte(nil)
+
+	for _, value := range resolved {
+		if value == nil {
+			continue
+		}
+
+		if value.EmitRequested() || value.Role() == primitive.ValueRoleReadout || value.Role() == primitive.ValueRoleAssociation {
+			generation = append(generation, []byte(value.String())...)
+		}
+	}
+
+	if len(generation) > 0 {
+		return generation
+	}
+
+	if fallback != nil {
+		return []byte(fallback.String())
+	}
+
+	return nil
+}
+
+func classLabelsForPipeline(experiment tools.PipelineExperiment, resolved []*primitive.Value) []string {
+	classLabels := make([]string, 0, len(resolved))
+
+	for _, result := range resolved {
+		label := classLabelStringForPipeline(experiment, result)
+		if label == "" {
+			continue
+		}
+
+		classLabels = append(classLabels, label)
+	}
+
+	return classLabels
+}
