+	// Only READY residents are scheduled for ALU execution. DONE/RESOLVED
+	// frames still update the resident memory above, but allowing them back into
+	// the reader pipeline creates self-sustaining replays with no new work.
+	if resident != nil && resident.Status() == primitive.READY {
